rules_version = '2';
// 도코데 Firestore 보안 규칙
// trips/{tripId}: 여행 하나. 함께 편집하는 사람은 memberIds 에 들어 있어요.
//  - 멤버: 읽기·일정 고치기
//  - 만든 사람(owner): 공유 설정 바꾸기, 지우기
//  - 보기 링크(public == true): 링크(문서 ID)를 아는 사람은 로그인 없이 일정만 읽기
// trips/{tripId}/priv/main: 편집 초대 키(editKey)와 경비(payJson). 멤버만 읽고 써요.
//  - 편집 초대 링크: editKey 를 아는 로그인 사용자가 자기 자신을 멤버로 추가
//  - 예전 여행은 editKey 가 trips 문서에 남아 있을 수 있어요(주인이 열면 priv 로 옮겨져요)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember() { return signedIn() && request.auth.uid in resource.data.memberIds; }
    function isOwner() { return signedIn() && resource.data.owner == request.auth.uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function tripDoc(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)); }
    function privPath(tripId) { return /databases/$(database)/documents/trips/$(tripId)/priv/main; }
    function joinKeyOk(tripId) {
      return (resource.data.get('editKey', null) != null && request.resource.data.joinKey == resource.data.editKey)
        || (exists(privPath(tripId)) && request.resource.data.joinKey == get(privPath(tripId)).data.editKey);
    }

    match /trips/{tripId} {
      // 목록 조회는 내 여행만 (memberIds array-contains 내 uid 로 질의)
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow get: if isMember() || resource.data.public == true;

      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.get('editKey', null) == null
        && request.resource.data.editsJson is string && request.resource.data.editsJson.size() < 600000;

      // 멤버는 일정 내용만 고칠 수 있어요
      allow update: if isMember()
        && changed().hasOnly(['title', 'start', 'end', 'stay', 'editsJson', 'updatedAt', 'updatedBy'])
        && request.resource.data.editsJson.size() < 600000;

      // 만든 사람은 공유 설정까지 바꿀 수 있어요 (멤버 내보내기 포함, 자기 자신은 빼지 못해요)
      // 편집 키는 지울 수만 있어요 (priv 문서로 옮길 때)
      allow update: if isOwner()
        && !changed().hasAny(['owner'])
        && request.auth.uid in request.resource.data.memberIds
        && (!changed().hasAny(['editKey']) || request.resource.data.get('editKey', null) == null)
        && request.resource.data.editsJson.size() < 600000;

      // 편집 초대 링크로 들어오기: 맞는 editKey 를 joinKey 로 함께 보내고, 자기 uid 하나만 추가
      allow update: if signedIn()
        && changed().hasOnly(['memberIds', 'members', 'joinKey'])
        && joinKeyOk(tripId)
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.removeAll(resource.data.memberIds).hasOnly([request.auth.uid])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);

      allow delete: if isOwner();

      match /priv/{docId} {
        function trip() { return tripDoc(tripId).data; }
        function member() { return signedIn() && request.auth.uid in trip().memberIds; }
        allow get: if docId == 'main' && member();
        // 처음 만들 때: 주인은 새 키, 멤버는 예전 여행의 키를 그대로 옮기기만
        allow create: if docId == 'main' && member()
          && request.resource.data.keys().hasOnly(['editKey', 'payJson'])
          && request.resource.data.editKey is string && request.resource.data.editKey.size() >= 16
          && (trip().owner == request.auth.uid || request.resource.data.editKey == trip().get('editKey', ''))
          && request.resource.data.get('payJson', '') is string && request.resource.data.get('payJson', '').size() < 400000;
        // 경비는 멤버 누구나, 편집 키는 주인만 바꿔요
        allow update: if docId == 'main' && member()
          && request.resource.data.keys().hasOnly(['editKey', 'payJson'])
          && (request.resource.data.editKey == resource.data.editKey || trip().owner == request.auth.uid)
          && request.resource.data.editKey is string && request.resource.data.editKey.size() >= 16
          && request.resource.data.payJson is string && request.resource.data.payJson.size() < 400000;
        allow delete: if signedIn() && trip().owner == request.auth.uid;
      }
    }
  }
}
